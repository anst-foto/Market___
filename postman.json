{
	"info": {
		"_postman_id": "b2c3d4e5-f6a7-890b-cdef-1234567890ab",
		"name": "Market API Tests",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://localhost:5001",
			"type": "string"
		},
		{
			"key": "productId",
			"value": "",
			"type": "string"
		},
		{
			"key": "fixedGuid",
			"value": "11111111-2222-3333-4444-555555555555",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/",
					"host": ["{{baseUrl}}"],
					"path": [""]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response body is empty', function () {",
							"    pm.response.to.have.body('');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Create product with fixed GUID",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"guid\": \"{{fixedGuid}}\",\n    \"name\": \"Fixed Product\",\n    \"price\": 50.0\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/products",
					"host": ["{{baseUrl}}"],
					"path": ["products"]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Product has expected GUID', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.guid).to.eql(pm.collectionVariables.get('fixedGuid'));",
							"});",
							"",
							"// Save this GUID for later operations",
							"pm.collectionVariables.set('productId', pm.collectionVariables.get('fixedGuid'));"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Duplicate product with same GUID (negative test)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"guid\": \"{{fixedGuid}}\",\n    \"name\": \"Duplicate\",\n    \"price\": 100\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/products",
					"host": ["{{baseUrl}}"],
					"path": ["products"]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 400 Bad Request', function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"pm.test('Error message contains conflict text', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('error');",
							"    pm.expect(jsonData.error).to.include('уже существует');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Get all products",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products",
					"host": ["{{baseUrl}}"],
					"path": ["products"]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response is an array containing fixed product', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    const found = jsonData.some(p => p.guid === pm.collectionVariables.get('fixedGuid'));",
							"    pm.expect(found).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Get product by fixed GUID",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products/{{fixedGuid}}",
					"host": ["{{baseUrl}}"],
					"path": ["products", "{{fixedGuid}}"]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Product has correct fields', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('guid', pm.collectionVariables.get('fixedGuid'));",
							"    pm.expect(jsonData).to.have.property('name', 'Fixed Product');",
							"    pm.expect(jsonData).to.have.property('price', 50.0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Update product",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"guid\": \"{{fixedGuid}}\",\n    \"name\": \"Updated Fixed Product\",\n    \"price\": 75.5\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/products/{{fixedGuid}}",
					"host": ["{{baseUrl}}"],
					"path": ["products", "{{fixedGuid}}"]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Updated fields are correct', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('guid', pm.collectionVariables.get('fixedGuid'));",
							"    pm.expect(jsonData).to.have.property('name', 'Updated Fixed Product');",
							"    pm.expect(jsonData).to.have.property('price', 75.5);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Delete product",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products/{{fixedGuid}}",
					"host": ["{{baseUrl}}"],
					"path": ["products", "{{fixedGuid}}"]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 204 No Content', function () {",
							"    pm.response.to.have.status(204);",
							"});",
							"",
							"pm.test('Response body is empty', function () {",
							"    pm.response.to.have.body('');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "Get deleted product – should return 404",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products/{{fixedGuid}}",
					"host": ["{{baseUrl}}"],
					"path": ["products", "{{fixedGuid}}"]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 404 Not Found', function () {",
							"    pm.response.to.have.status(404);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		}
	]
}